{
  "name": "ratchet-ts",
  "version": "0.1.0",
  "description": "Hybrid X25519 + ML-KEM-768 Double Ratchet in TypeScript. Forward secrecy, post-compromise security, and post-quantum handshake. MIT.",
  "license": "MIT",
  "author": {
    "name": "Gintaras Zilinskas",
    "email": "239629917+gntrs@users.noreply.github.com",
    "url": "https://github.com/gntrs"
  },
  "type": "module",
  "keywords": [
    "double-ratchet",
    "post-quantum",
    "ml-kem",
    "x25519",
    "e2ee",
    "signal-protocol",
    "xchacha20",
    "pqxdh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gntrs/ratchet-ts.git"
  },
  "homepage": "https://github.com/gntrs/ratchet-ts#readme",
  "bugs": {
    "url": "https://github.com/gntrs/ratchet-ts/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "^2.0.1",
    "@noble/post-quantum": "0.6.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
